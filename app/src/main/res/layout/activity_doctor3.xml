<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".Doctor3Activity">

    <!-- Header with back arrow and title -->
    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="4dp"
        android:contentDescription="Back"
        android:src="@drawable/backarrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Meal Logs"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        app:layout_constraintStart_toEndOf="@id/backArrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/backArrow"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"/>

    <!-- Subtitle: Patient and date -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Patient: Kavya | Date: 30 Aug 2025"
        android:textSize="12sp"
        android:textColor="#6B7280"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"/>

    <!-- Daily Meal Log Title -->
    <TextView
        android:id="@+id/dailyMealLogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Meal Log for 30 Aug"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#111827"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"/>

    <!-- Meal log entries container -->
    <LinearLayout
        android:id="@+id/mealLogContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/dailyMealLogTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/complianceCard"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <!-- Breakfast -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            app:cardElevation="2dp"
            app:cardCornerRadius="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/mealName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Breakfast"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />
                    <TextView
                        android:id="@+id/mealTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8:00 AM"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/mealStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logged"
                    android:textColor="#22C55E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Morning Snack -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            app:cardElevation="2dp"
            app:cardCornerRadius="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/morningSnackName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Morning Snack"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />
                    <TextView
                        android:id="@+id/morningSnackTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:30 AM"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/morningSnackStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logged"
                    android:textColor="#22C55E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Lunch with swapped info -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            app:cardElevation="2dp"
            app:cardCornerRadius="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/lunchName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lunch"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#111827" />
                        <TextView
                            android:id="@+id/lunchTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1:00 PM"
                            android:textSize="13sp"
                            android:textColor="#6B7280"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/lunchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swapped"
                        android:textColor="#EF4444"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- Lunch Swap info with ImageView for icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/button"
                        android:contentDescription="swap icon" />
                    <TextView
                        android:id="@+id/lunchSwapInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Papaya instead of Banana"
                        android:textSize="12sp"
                        android:textColor="#B91C1C"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Evening Snack skipped -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            app:cardElevation="2dp"
            app:cardCornerRadius="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/eveningSnackName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evening Snack"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />
                    <TextView
                        android:id="@+id/eveningSnackTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4:00 PM"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/eveningSnackStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skipped"
                    android:textColor="#DC2626"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dinner logged -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:cardElevation="2dp"
            app:cardCornerRadius="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/dinnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dinner"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />
                    <TextView
                        android:id="@+id/dinnerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7:30 PM"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/dinnerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logged"
                    android:textColor="#22C55E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Compact Compliance Rate card, directly above button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/complianceCard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_margin="16dp"
        android:background="#FFFFFF"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnDoctorProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
            <TextView
                android:id="@+id/complianceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compliance Rate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827" />
            <TextView
                android:id="@+id/compliancePercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4B5563"
                android:layout_marginTop="4dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logged: 4"
                    android:textSize="11sp"
                    android:textColor="#6B7280"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Swapped: 1"
                    android:textSize="11sp"
                    android:textColor="#6B7280"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skipped: 1"
                    android:textSize="11sp"
                    android:textColor="#6B7280" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Doctor Profile Button -->
    <Button
        android:id="@+id/btnDoctorProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Go to Doctor Profile"
        android:textAllCaps="false"
        android:backgroundTint="@android:color/holo_blue_light"
        android:textColor="@android:color/white"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
