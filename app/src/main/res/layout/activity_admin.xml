<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC"
    tools:context=".AdminActivity">

    <!-- Welcome Header -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, Admin 👋"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- Search Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/search"
                android:contentDescription="Search icon" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search for doctors or patients..."
                android:textColor="#4B5563"
                android:textSize="16sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Doctors List Label -->
    <TextView
        android:id="@+id/doctorsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doctors List 👨‍⚕️"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Doctor 1 Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/doctor1Card"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/doctorsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/doc1Image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/doctor1"
                android:background="@drawable/bg_circle"
                android:contentDescription="Doctor image"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/doc1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Shivam"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/doc1Speciality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiology"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/doc1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="Approved"
                    android:textSize="12sp"
                    android:textColor="#059669"
                    android:gravity="center"
                    android:background="@drawable/bg_approved_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/doc1ViewBtn"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:text="View"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_blue"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Doctor 2 Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/doctor2Card"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/doctor1Card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/doc2Image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/femaledoc"
                android:background="@drawable/bg_circle"
                android:contentDescription="Doctor image"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/doc2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Kavi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/doc2Speciality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pediatrics"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/doc2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="Pending"
                    android:textSize="12sp"
                    android:textColor="#B45309"
                    android:gravity="center"
                    android:background="@drawable/bg_pending_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/doc2ViewBtn"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:text="View"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_blue"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Patients List Label -->
    <TextView
        android:id="@+id/patientsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patients List 👩‍⚕️"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1E2937"
        android:layout_marginTop="28dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/doctor2Card"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Patient 1 Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/patient1Card"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/patientsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/patient1Image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/female"
                android:background="@drawable/bg_circle"
                android:contentDescription="Patient image"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/patient1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kavya"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/patient1Details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Female, 28"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/patient1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="Assigned"
                    android:textSize="12sp"
                    android:textColor="#2563EB"
                    android:gravity="center"
                    android:background="@drawable/bg_assigned_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/patient1ViewBtn"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:text="View"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_blue"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Patient 2 Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/patient2Card"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/patient1Card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/patient2Image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/male"
                android:background="@drawable/bg_circle"
                android:contentDescription="Patient image"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/patient2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sakthi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/patient2Details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Male, 45"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/patient2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="Not assigned"
                    android:textSize="12sp"
                    android:textColor="#059669"
                    android:gravity="center"
                    android:background="@drawable/bg_pending_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/patient2ViewBtn"
                android:layout_width="130dp"
                android:layout_height="40dp"
                android:text="View"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_blue"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@android:color/transparent"
        app:menu="@menu/bottom_nav_admin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:labelVisibilityMode="labeled"/>

</androidx.constraintlayout.widget.ConstraintLayout>
