<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context=".MealActivity">

    <!-- Top Bar with Back Button -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#3A80ED">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/backarrow"
            android:contentDescription="Back"
            android:padding="6dp"
            android:background="@drawable/rounded_icon_bg"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meal Plan"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- Scrollable Meals -->
    <ScrollView
        android:id="@+id/mealScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/mealsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp"
            android:paddingTop="18dp">

            <!-- Date Header -->
            <TextView
                android:id="@+id/dateHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 August 2025 (Today)"
                android:textSize="16sp"
                android:textColor="#999999"
                android:layout_marginTop="8dp"
                android:layout_marginStart="20dp" />

            <!-- Main Heading -->
            <TextView
                android:id="@+id/tvCurrentMeal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today's Meal will appear here"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3A80ED"
                android:padding="16dp"
                android:gravity="center" />


            <!-- ====== Meal Cards ====== -->

            <!-- Oats -->
            <LinearLayout
                android:id="@+id/cardBreakfast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_background"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgBreakfast"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/oat"
                    android:scaleType="centerCrop"
                    android:contentDescription="Oats" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvBreakfastTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetable oat porridge"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBreakfastTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Breakfast (9:00 AM)"
                        android:textSize="14sp"
                        android:textColor="#999999" />

                    <TextView
                        android:id="@+id/tvBreakfastDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rich in fibre and protein"
                        android:textSize="14sp"
                        android:textColor="#666" />

                    <!-- Logged & Skipped Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnBreakfastLogged"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Logged ✅"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4CAF50"
                            android:background="@drawable/rounded_button"
                            android:padding="8dp" />

                        <Button
                            android:id="@+id/btnBreakfastSkipped"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Skipped ❌"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#F44336"
                            android:background="@drawable/rounded_button"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnBreakfastSwap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/button"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Swap" />
            </LinearLayout>

            <!-- Smoothie -->
            <LinearLayout
                android:id="@+id/cardSnack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_background"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgSnack"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/smoothie"
                    android:scaleType="centerCrop"
                    android:contentDescription="Smoothie" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvSnackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fruit Smoothie"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSnackTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mid-Morning Snack (11:30 AM)"
                        android:textSize="14sp"
                        android:textColor="#999999" />

                    <TextView
                        android:id="@+id/tvSnackDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boosts immunity"
                        android:textSize="14sp"
                        android:textColor="#666" />

                    <!-- Logged & Skipped Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnSnackLogged"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Logged ✅"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4CAF50"
                            android:background="@drawable/rounded_button"
                            android:padding="8dp" />

                        <Button
                            android:id="@+id/btnSnackSkipped"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Skipped ❌"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#F44336"
                            android:background="@drawable/rounded_button"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSnackSwap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/button"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Swap" />
            </LinearLayout>

            <!-- Sambar -->
            <LinearLayout
                android:id="@+id/cardLunch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_background"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgLunch"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/sambar"
                    android:scaleType="centerCrop"
                    android:contentDescription="Sambar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvLunchTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sambar with Veggies"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLunchTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lunch (1:00 PM)"
                        android:textSize="14sp"
                        android:textColor="#999999" />

                    <TextView
                        android:id="@+id/tvLunchDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Protein-packed meal"
                        android:textSize="14sp"
                        android:textColor="#666" />

                    <!-- Logged & Skipped Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnLunchLogged"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Logged ✅"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4CAF50"
                            android:background="@drawable/rounded_button"
                            android:padding="8dp" />

                        <Button
                            android:id="@+id/btnLunchSkipped"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Skipped ❌"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#F44336"
                            android:background="@drawable/rounded_button"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnLunchSwap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/button"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Swap" />
            </LinearLayout>

            <!-- Idly -->
            <LinearLayout
                android:id="@+id/cardEvening"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_background"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgEvening"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/idly"
                    android:scaleType="centerCrop"
                    android:contentDescription="Idly" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvEveningTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Steamed Idly"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEveningTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evening Snack (4:30 PM)"
                        android:textSize="14sp"
                        android:textColor="#999999" />

                    <TextView
                        android:id="@+id/tvEveningDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light and healthy"
                        android:textSize="14sp"
                        android:textColor="#666" />

                    <!-- Logged & Skipped Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnEveningLogged"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Logged ✅"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4CAF50"
                            android:background="@drawable/rounded_button"
                            android:padding="8dp" />

                        <Button
                            android:id="@+id/btnEveningSkipped"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Skipped ❌"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#F44336"
                            android:background="@drawable/rounded_button"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnEveningSwap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/button"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Swap" />
            </LinearLayout>

            <!-- Stew -->
            <LinearLayout
                android:id="@+id/cardDinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_margin="12dp"
                android:background="@drawable/card_background"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgDinner"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/stew"
                    android:scaleType="centerCrop"
                    android:contentDescription="Stew" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvDinnerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetable Stew"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDinnerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dinner (7:30 PM)"
                        android:textSize="14sp"
                        android:textColor="#999999" />

                    <TextView
                        android:id="@+id/tvDinnerDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full of vitamins"
                        android:textSize="14sp"
                        android:textColor="#666" />

                    <!-- Logged & Skipped Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnDinnerLogged"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Logged ✅"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4CAF50"
                            android:background="@drawable/rounded_button"
                            android:padding="8dp" />

                        <Button
                            android:id="@+id/btnDinnerSkipped"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Skipped ❌"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#F44336"
                            android:background="@drawable/rounded_button"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnDinnerSwap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/button"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:contentDescription="Swap" />
            </LinearLayout>

            <!-- Save Button -->
            <LinearLayout
                android:id="@+id/saveMealLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/saveMealPlanBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Meal Plan ✅"
                    android:textSize="18sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#3A80ED"
                    android:padding="16dp"
                    android:elevation="6dp"
                    android:clipToOutline="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/rounded_button"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
