<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FA"
    tools:context=".Admin2Activity">

    <!-- Back Arrow -->
    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/backarrow"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Screen Title -->
    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Assignment"
        android:textColor="#131514"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/backArrow"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"/>

    <!-- Patient Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/patientCard"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/screenTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/female"
                android:contentDescription="Patient image"
                android:background="@drawable/bg_circle"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/patientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="yashika"
                    android:textColor="#16181C"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/patientCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Knee Replacement"
                    android:textColor="#4A7856"
                    android:textSize="15sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/patientSurgeryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Surgery on: March 15, 2024"
                    android:textColor="#1B2745"
                    android:textSize="15sp"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Assign to Doctor Label -->
    <TextView
        android:id="@+id/assignLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assign to Doctor"
        android:textColor="#22223B"
        android:textSize="15sp"
        android:textStyle="normal"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/patientCard"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Doctor Dropdown -->
    <androidx.cardview.widget.CardView
        android:id="@+id/doctorDropdownCard"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="13dp"
        app:cardElevation="0.5dp"
        app:layout_constraintTop_toBottomOf="@id/assignLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Spinner
            android:id="@+id/spinnerDoctor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textAlignment="viewStart"
            android:background="@android:color/transparent"
            android:popupBackground="#FFFFFF"/>
    </androidx.cardview.widget.CardView>

    <!-- Save Assignment Button -->
    <Button
        android:id="@+id/saveAssignmentBtn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Save Assignment"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#28F285"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="78dp"
        android:layout_marginTop="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@android:color/transparent"
        app:menu="@menu/bottom_nav_admin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:labelVisibilityMode="labeled"/>
</androidx.constraintlayout.widget.ConstraintLayout>
